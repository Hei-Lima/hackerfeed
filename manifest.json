{
  "manifest_version": 3,
  "name": "Hackerfeed",
  "version": "3.0",
  "description": "Replaces the Chrome homepage with Hackerfeed, providing a curated feed of tech news and updates. Powered by Hacker News.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "topSites"
  ],
  "action": {
    "default_icon": "icons/icon.png"
  }
}